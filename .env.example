# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser. Needed for usage metering, leads and payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Payments: shared secret appended to the webhook URL you give your payment provider:
#   https://YOUR_DOMAIN/api/billing/webhook?token=<this value>
BILLING_WEBHOOK_SECRET=

# Comma-separated emails allowed to use /app/admin (manual plan activation)
ADMIN_EMAILS=
NEXT_PUBLIC_SITE_URL=
